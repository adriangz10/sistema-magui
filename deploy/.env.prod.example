# Copiar a deploy/.env.prod en el VPS y completar. Nunca subir .env.prod al repositorio.

# Dominio que apunta al VPS (registro A) y correo para los avisos de Let's Encrypt.
DOMINIO=magui.ejemplo.com
EMAIL_ACME=duena@ejemplo.com

# Base de datos (contraseñas largas y distintas: openssl rand -base64 24).
MYSQL_ROOT_PASSWORD=
DB_NAME=magui
DB_USER=magui
DB_PASSWORD=

# Firma de las sesiones (mínimo 32 caracteres): openssl rand -base64 48
AUTH_SECRET=
SESSION_DURATION=720h

# Copias de seguridad diarias en deploy/backups: hora (Argentina) y cuántos días se guardan.
BACKUP_HORA=03:00
BACKUP_DIAS=14

# Versión que se muestra en /api/health (opcional).
VERSION=1.0.0
