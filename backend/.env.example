# Copiar a .env y completar. Nunca subir .env al repositorio.
APP_ENV=dev
HTTP_ADDR=:8080
ALLOWED_ORIGINS=http://localhost:4200

DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=magui

# Sesiones de la dueña. AUTH_SECRET es obligatorio en producción (mínimo 32 caracteres).
# Generar uno con: openssl rand -base64 48
AUTH_SECRET=
SESSION_DURATION=720h

# Detrás de un proxy HTTPS (Caddy): IPs o rangos del proxy, separados por comas. Solo de ellos se acepta
# X-Forwarded-For para saber la IP real del cliente (límite de intentos de ingreso). Vacío = sin proxy.
TRUSTED_PROXIES=

# Carpeta del frontend compilado (npm run build). Si se define, la API sirve también la app web.
FRONTEND_DIR=../frontend/dist/frontend/browser
